  METHOD input_modules.
    CASE is_context-module.
      WHEN 'EXIT_0100'.
        CLEAR gv_ok_code.
        io_session->get_dialog( )->leave_to_screen( '0000' ).
      WHEN 'CHECK_CARRID'.
        IF NOT line_exists( gt_carriers[ carrid = gv_carrid ] ).
          io_session->message( VALUE #( type = zif_gg_session_types_v1=>message_type_error text = |Airline { gv_carrid } does not exist| ) ).
        ENDIF.
      WHEN 'F4_CARRID'.
        io_session->get_compatibility( )->f4_table_value_request( EXPORTING is_request = VALUE #( retfield = 'CARRID' dynpprog = io_session->get_context( )-program-program dynpnr = io_session->get_context( )-dynpro-screen dynprofield = 'GV_CARRID' value_org = 'S' ) CHANGING ct_value_tab = gt_carriers ).
      WHEN 'USER_COMMAND_0100'.
        IF gv_ok_code = 'EDIT'.
          CLEAR gv_ok_code.
          gt_shown = VALUE #( FOR ls_flight IN gt_flights WHERE ( carrid = gv_carrid ) ( ls_flight ) ).
          io_session->get_dialog( )->leave_to_screen( '0200' ).
        ENDIF.
        CLEAR gv_ok_code.
      WHEN 'EXIT_0200'.
        CLEAR gv_ok_code.
        io_session->get_dialog( )->leave_to_screen( '0100' ).
      WHEN 'MODIFY_FLIGHT'.
        MODIFY gt_shown FROM gs_flight INDEX tc_flights-current_line.
      WHEN 'USER_COMMAND_0200'.
        IF gv_ok_code = 'SAVE'.
          LOOP AT gt_shown INTO gs_flight.
            MODIFY gt_flights FROM gs_flight TRANSPORTING cityfrom cityto WHERE carrid = gs_flight-carrid AND connid = gs_flight-connid.
          ENDLOOP.
          io_session->message( VALUE #( type = zif_gg_session_types_v1=>message_type_success text = |{ lines( gt_shown ) } flights of { gv_carrid } saved| ) ).
        ENDIF.
        CLEAR gv_ok_code.
      WHEN OTHERS.
        RETURN.
    ENDCASE.
  ENDMETHOD.

