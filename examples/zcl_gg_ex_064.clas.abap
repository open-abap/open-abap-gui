  METHOD input_modules.
    CASE is_context-module.
      WHEN 'EXIT_0100'.
        CLEAR gv_ok_code.
        io_session->get_dialog( )->leave_to_screen( '0000' ).
      WHEN 'USER_COMMAND_0100'.
        gv_field = is_context-cursor_field.
        CASE gv_ok_code.
          WHEN 'ADD'.
            gv_count = gv_count + 1.
            gv_cursor = 'GV_NOTE'.
            io_session->message( VALUE #( type = zif_gg_session_types_v1=>message_type_success text = |Note { gv_count } added, cursor was in { gv_field }| ) ).
          WHEN 'UNDO'.
            gv_count = gv_count - 1.
            gv_cursor = 'GV_TITLE'.
            io_session->message( VALUE #( type = zif_gg_session_types_v1=>message_type_success text = |Note removed, cursor was in { gv_field }| ) ).
        ENDCASE.
        CLEAR gv_ok_code.
      WHEN OTHERS.
        RETURN.
    ENDCASE.
