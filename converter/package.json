{
  "name": "@abaplint/open-abap-gui-converter",
  "version": "0..0",
  "description": "Deterministic, offline conversion of classic ABAP executable reports to the versioned scaffold interfaces.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "open-abap-gui-convert": "bin/convert.mjs"
  },
  "scripts": {
    "publish:dryrun": "npm run test && npm publish --dry-run --access public",
    "publish:patch": "npm --no-git-tag-version version patch && npm install && npm run test && npm publish --access public",
    "check": "node bin/convert.mjs ../scaffold/examples/zgg_ex_001.prog.abap --check",
    "check:matrix": "node test/check-fixtures.mjs",
    "test:unit": "node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test": "node test/verify.mjs",
    "test:ci": "node test/verify.mjs --skip behavior",
    "fixtures": "node test/run-fixtures.mjs",
    "structural": "node test/structural-snapshots.mjs",
    "warnings": "node test/warnings.mjs",
    "hardening": "node test/hardening.mjs",
    "coverage": "node test/coverage.mjs",
    "transpile": "node test/transpile-generated.mjs",
    "behavior": "node test/behavioral-generated.mjs",
    "browser": "node test/browser-generated.mjs",
    "test:gg-gui": "node test/gg-gui.mjs",
    "verify": "node test/verify.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@abaplint/core": "^2.120.57"
  },
  "license": ""
}
