{
  "name": "open-abap-gui",
  "version": "1.0.0",
  "private": true,
  "description": "GUI controls for open-abap",
  "scripts": {
    "lint": "abaplint",
    "transpile": "abap_transpile",
    "unit": "abap_transpile && echo RUNNING && node output/index.mjs",
    "test:html-http": "node integration/html-http.mjs",
    "test:html-browser": "node integration/html-browser.mjs",
    "install:html-browser": "playwright install chromium",
    "test:html-e2e": "npm run transpile && npm run test:html-browser",
    "start:html": "npm run transpile && node host/abap-html-server.mjs",
    "test": "npm run lint && npm run unit && npm run test:html-http",
    "regression": "node .github/regression/run.js"
  },
  "license": "",
  "dependencies": {
    "@abaplint/cli": "^2.120.38",
    "@abaplint/database-sqlite": "^2.13.40",
    "@abaplint/runtime": "^2.13.64",
    "@abaplint/transpiler-cli": "^2.13.64",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
