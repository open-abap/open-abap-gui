{
  "name": "open-abap-gui",
  "version": "1.0.0",
  "private": true,
  "description": "GUI controls for open-abap",
  "scripts": {
    "lint": "abaplint",
    "transpile": "abap_transpile",
    "unit": "abap_transpile && echo RUNNING && node output/index.mjs",
    "test:html-browser": "playwright test",
    "install:html-browser": "playwright install chromium",
    "test:html-e2e": "npm run transpile && npm run test:html-browser",
    "start": "npm run transpile && node test/start-server.mjs",
    "web:screenshots": "node test/capture-web-screenshots.mjs",
    "web:diff": "node test/generate-screenshot-diffs.mjs deployment/main/screenshots build/screenshots build/visual-diffs",
    "web:build": "npm run transpile && webpack --config webpack.config.cjs --mode production && npm run web:screenshots && npm run web:diff",
    "test": "npm run lint && npm run unit && npm run test:html-browser",
    "regression": "node .github/regression/run.js"
  },
  "license": "",
  "dependencies": {
    "@abaplint/cli": "^2.120.40",
    "@abaplint/database-sqlite": "^2.13.40",
    "@abaplint/runtime": "^2.13.64",
    "@abaplint/transpiler-cli": "^2.13.64",
    "express": "^4.22.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.8",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3"
  }
}
